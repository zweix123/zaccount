from dryads import Dryads, argv  # type: ignore

from entry import EntryList  # type: ignore
from utils import get_data_file_path  # type: ignore


class Operation:
    def __init__(self, method: str) -> None:
        assert method in ["w", "r"], f"method {method}"
        self.method = method
        self.filepath = get_data_file_path()
        self.data: EntryList = EntryList([])

    def __enter__(self) -> "Operation":
        self.data = EntryList.from_csv_file(self.filepath)
        return self

    def __exit__(self, exc_type, exc_value, traceback) -> None:
        if self.method == "w":
            self.data.to_csv_file(self.filepath)


def sum():
    """计算资产总额"""
    with Operation("r") as op:
        by_account = op.data.sum_by_account()
        for account, total in by_account.items():
            print(f"[{account}] 资产总额: {total:,.2f}元")
        print(f"[汇总] 资产总额: {op.data.sum():,.2f}元")


def tags():
    """查看所有标签"""
    with Operation("r") as op:
        tags = set()
        for entry in op.data:
            tags.update(entry.tags)
        print(tags)


def group_by_tag():
    """搜索标签"""
    if len(argv) != 1:
        print("Need tag")
        return
    tag = argv[0]
    print(f"tag: {tag}")
    with Operation("r") as op:
        op.data = op.data.filter(lambda x: tag in x.tags)
        print(f"资产总额: {op.data.sum():,.2f}元")


cmds = {
    "sum": sum,
    "tags": tags,
    "group-by-tag": group_by_tag,
}

Dryads(cmds)  # type: ignore
